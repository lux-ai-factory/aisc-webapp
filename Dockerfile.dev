# Development Dockerfile for VERA webapp

# Build Stage
FROM node:22.23.3-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

# Set working directory for all subsequent operations
WORKDIR /app

# Copy package files first to leverage Docker layer caching
COPY package.json package-lock.json ./
RUN npm install

# Start development server directly
CMD ["npm", "run", "dev"]
